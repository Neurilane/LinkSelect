        "backgroundColor": "#1A5276"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.neurilane.linkselect"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6542c432-d753-41d0-8ef7-de5a22f39b76"
      }
    }
  }
}